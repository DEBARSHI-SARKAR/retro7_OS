# retro7 kconfig fragment — merged onto the fork's msm8916_defconfig.
# NOTE: no trailing comments after values — keep comments on their own lines.
# Symbols get pinned during the M1 build loop; a stale one just warns.

# --- modules must be on (our drivers ride as .ko; Image alone isn't enough)
CONFIG_MODULES=y

# --- filesystem / usability
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_SYSVIPC=y
CONFIG_TUN=y

# --- input / HID (gamepad path; touchscreen driver item below)
CONFIG_INPUT_EVDEV=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID=m
CONFIG_HIDRAW=y
CONFIG_UHID=m

# --- USB rescue gadget: NCM network + ACM serial (usb-gadget.sh)
# fork defconfig has USB_GADGET/CHIPIDEA but NO configfs gadget functions
CONFIG_USB_CONFIGFS=y
# NOTE: acm/ncm have NO F_ prefix — F_* exists only for newer functions
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
# SM5703 MUIC handled by sm5502 extcon driver
CONFIG_EXTCON_SM5502=y
# USB role-switch/VBUS-boost config lands with bring-up §4

# --- touch: upstream zinitix driver exists; ZT7548 compatible may need
#     the fork patch (bring-up)
CONFIG_TOUCHSCREEN_ZINITIX=m

# --- display fbdev for X11
CONFIG_DRM_FBDEV_EMULATION=y

# --- audio: exact CONFIG_SND_* msm8916 symbols get pinned during M1 build
#     (see docs/bringup.md)
